{
  "Name": "messwerte",
  "Description": "Viertelstundenwerte der Netzbetreiber, eine CSV-Datei je Tag",
  "TableType": "EXTERNAL_TABLE",
  "Parameters": {
    "classification": "csv",
    "skip.header.line.count": "1"
  },
  "StorageDescriptor": {
    "Columns": [
      {"Name": "zaehlpunkt", "Type": "string"},
      {"Name": "zeitpunkt", "Type": "string"},
      {"Name": "richtung", "Type": "string"},
      {"Name": "kwh", "Type": "string"}
    ],
    "Location": "s3://viertelwatt-rohdaten/rohdaten/",
    "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
    "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
    "SerdeInfo": {
      "SerializationLibrary": "org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe",
      "Parameters": {"field.delim": ";"}
    }
  }
}
